# Database (MySQL for production, SQLite for local testing)
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/ganadi_db
# DATABASE_URL=sqlite:///./petcare.db  # 로컬 테스트용

# development | staging | production
ENVIRONMENT=development

# JWT
SECRET_KEY=change-this-to-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Server
AI_SERVER_URL=http://localhost:8000

# CORS (프론트엔드 주소)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── 카카오 로그인
# 카카오 개발자 콘솔 > 앱 > 플랫폼 > Web > 사이트 도메인 / Redirect URI 에 아래와 동일하게 등록
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
# 로컬에서 포트·LAN IP 바뀔 때마다 콘솔에 URI 추가하기 번거로우면 false (항상 위 URI만 사용)
# KAKAO_REDIRECT_USE_REFERER=false

# 배포 메타 (선택) — / 및 /health 응답에 build 필드로 노출
# SERVICE_BUILD_LABEL=prod-2026-05-11-gitabc123

# AWS S3 (선택사항 - 설정하면 S3 사용, 없으면 로컬 저장)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_S3_BUCKET=ganadi-pet-images
# AWS_REGION=ap-northeast-2

# ── 토스페이먼츠 테스트 결제 (비우면 /payments/toss/* 비활성 — 소견 요청 시 503)
# https://developers.tosspayments.com 에서 테스트 클라이언트 키·시크릿 키 발급
# FRONTEND_ORIGIN 은 브라우저 주소와 동일해야 리다이렉트 성공 (모바일 LAN 이면 http://192.168.x.x:5173)
FRONTEND_ORIGIN=http://localhost:5173

# ── 실제 메일 (네이버 SMTP) — POP3/SMTP 사용 켜기 필수
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USER=your@naver.com
SMTP_PASSWORD=네이버로그인비밀번호
SMTP_USE_SSL=true
SMTP_USE_TLS=false
EMAIL_FROM=your@naver.com
EMAIL_FROM_NAME=PET EYE AI
ADMIN_NOTIFY_EMAIL=your@naver.com
EMAIL_DEV_EXPOSE_LINK=false

# ── 로컬 Mailpit 테스트 — docker run -d --name peteye-mailpit -p 8025:8025 -p 1025:1025 axllent/mailpit
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USE_SSL=false
# SMTP_USE_TLS=false
# EMAIL_FROM=noreply@peteyeai.com
# ADMIN_NOTIFY_EMAIL=admin@local.test
# TOSS_PAYMENTS_CLIENT_KEY=test_ck_...
# TOSS_PAYMENTS_SECRET_KEY=test_sk_...
# OPINION_SERVICE_FEE_WON=30000

# ── 이메일 (비밀번호 재설정·신고/관리자 안내)
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, 앱 비밀번호 사용
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true
# EMAIL_FROM=noreply@peteyeai.com
# EMAIL_FROM_NAME=PET EYE AI
# PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password
# PASSWORD_RESET_EXPIRE_MINUTES=60
# ADMIN_NOTIFY_EMAIL=admin@example.com
# 웹훅(notify): 공개 URL 필요 — 로컬은 ngrok 등. 보안 키는 개발자센터 웹훅 설정값.
# TOSS_WEBHOOK_SECURITY_KEY=
