# =============================================================================
# PET EYE AI — 프로덕션 환경변수 템플릿
# 서버의 backend/.env 로 복사한 뒤 값을 채우세요. Git 커밋 금지.
# =============================================================================

ENVIRONMENT=production

# ── RDS MySQL ──
DATABASE_URL=mysql+pymysql://ganadi_user:CHANGE_ME@${RDS_ENDPOINT}:3306/ganadi_local

# ── JWT (openssl rand -hex 32 로 생성) ──
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── 내부 서비스 ──
AI_SERVER_URL=http://ai:8000

# ── CORS·프론트 (실제 도메인만) ──
CORS_ORIGINS=https://ganadi.site
FRONTEND_ORIGIN=https://ganadi.site
PASSWORD_RESET_URL_BASE=https://ganadi.site

# ── 카카오 OAuth ──
# 콘솔: Web 도메인 https://ganadi.site, Redirect https://ganadi.site/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://ganadi.site/auth/kakao/callback
KAKAO_REDIRECT_USE_REFERER=false

# ── 배포 메타 (선택) ──
SERVICE_BUILD_LABEL=prod-YYYY-MM-DD-gitsha

# ── AWS S3 (권장 — 업로드 영속성) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ganadi-pet-images
AWS_REGION=ap-northeast-2

# ── Web Push VAPID (고정 키 필수 — 재시작마다 바뀌면 구독 무효) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@ganadi.site

# ── 토스페이먼츠 ──
# 웹훅 URL: https://ganadi.site/api/payments/toss/webhook
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
TOSS_WEBHOOK_SECURITY_KEY=
OPINION_SERVICE_FEE_WON=30000

# ── SMTP (비밀번호 재설정·신고 메일) ──
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
EMAIL_FROM=
EMAIL_FROM_NAME=PET EYE AI
ADMIN_NOTIFY_EMAIL=
EMAIL_DEV_EXPOSE_LINK=false
PASSWORD_RESET_EXPIRE_MINUTES=60

# ── Docker Compose 전용 (deploy-prod.sh 참고) ──
# RDS_ENDPOINT=your-rds.xxxx.ap-northeast-2.rds.amazonaws.com
# DB_PASSWORD=
# VITE_KAKAO_MAP_KEY=
